# ==========================================
# AutoDesk Backend - Environment Variables Example
# Copy this file to .env and fill in your values
# ==========================================

# Server Port
SERVER_PORT=8080

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=autodesk_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/autodesk_db

# Security & JWT Configuration
JWT_SECRET=your_secret_key_here_must_be_at_least_256_bits_long
JWT_EXPIRATION_MS=86400000

# Spring AI (Google GenAI / Gemini API Key)
SPRING_AI_GOOGLE_GENAI_API_KEY=your_gemini_api_key_here
